"""Р вЂ™Р С”Р В»Р В°Р Т‘Р С”Р В° Roadmap РІР‚вЂќ Р Р†РЎРѓР Вµ Р СР С•Р Т‘РЎС“Р В»Р С‘ strategies/*.py Р С‘ Р РЋР вЂєР С›Р В Р С‘РЎвЂ¦ Р С—Р С•Р Т‘Р С”Р В»РЎР‹РЎвЂЎР ВµР Р…Р С‘РЎРЏ.

Р вЂ”Р В°РЎвЂЎР ВµР С: Р С•Р Т‘Р Р…Р В° РЎвЂљР В°Р В±Р В»Р С‘РЎвЂ Р В° Р Р†Р СР ВµРЎРѓРЎвЂљР С• РЎРѓР С—Р С•РЎР‚Р В° Р’В«Р С—Р С•Р Т‘Р С”Р В»РЎР‹РЎвЂЎР ВµР Р…Р С• Р С‘Р В»Р С‘ Р Р…Р ВµРЎвЂљР’В». Р С™Р В°Р В¶Р Т‘Р В°РЎРЏ Р С”Р С•Р В»Р С•Р Р…Р С”Р В° РІР‚вЂќ Р С•РЎвЂљР Т‘Р ВµР В»РЎРЉР Р…РЎвЂ№Р в„–
РЎРѓР В»Р С•Р в„– Р С—Р В°Р в„–Р С—Р В»Р В°Р в„–Р Р…Р В°, Р С‘ Р С—Р С• Р С”Р В°Р В¶Р Т‘Р С•Р в„– РЎРѓРЎвЂљРЎР‚Р С•Р С”Р Вµ Р Р†Р С‘Р Т‘Р Р…Р С•, Р Т‘Р С•Р С”РЎС“Р Т‘Р В° Р СР С•Р Т‘РЎС“Р В»РЎРЉ Р Т‘Р С•РЎв‚¬РЎвЂР В».

Р РЋР В»Р С•Р С‘ (РЎРѓР В»Р ВµР Р†Р В° Р Р…Р В°Р С—РЎР‚Р В°Р Р†Р С•):
  Standalone   РІР‚вЂќ РЎвЂћР В°Р в„–Р В» Р СР С•Р Т‘РЎС“Р В»РЎРЏ РЎРѓРЎС“РЎвЂ°Р ВµРЎРѓРЎвЂљР Р†РЎС“Р ВµРЎвЂљ Р Р† strategies/            (РІСљвЂњ РЎС“ Р Р†РЎРѓР ВµРЎвЂ¦)
  calc_*       РІР‚вЂќ РЎвЂћРЎС“Р Р…Р С”РЎвЂ Р С‘РЎРЏ РЎР‚Р В°РЎРѓРЎвЂЎРЎвЂРЎвЂљР В° РЎРѓР С‘Р С–Р Р…Р В°Р В»Р В° Р Р†Р Р…РЎС“РЎвЂљРЎР‚Р С‘ Р СР С•Р Т‘РЎС“Р В»РЎРЏ
  entry / exit РІР‚вЂќ check_entry / check_exit (live-Р С”Р С•Р Р…РЎвЂљРЎР‚Р В°Р С”РЎвЂљ РЎР‚Р ВµР ВµРЎРѓРЎвЂљРЎР‚Р В°)
  backtest     РІР‚вЂќ РЎвЂћРЎС“Р Р…Р С”РЎвЂ Р С‘РЎРЏ backtest(...) Р Р†Р Р…РЎС“РЎвЂљРЎР‚Р С‘ Р СР С•Р Т‘РЎС“Р В»РЎРЏ
  Р В Р ВµР ВµРЎРѓРЎвЂљРЎР‚       РІР‚вЂќ Р С”Р В»РЎР‹РЎвЂЎ Р Р† strategies/_registry.py РІвЂ вЂ™ REGISTRY (--/Р С”Р В»РЎР‹РЎвЂЎ)
  Р вЂР В°РЎвЂљРЎвЂЎ         РІР‚вЂќ Р С”Р В»РЎР‹РЎвЂЎ Р Р† ENABLED_BATCH (РЎС“РЎвЂЎР В°РЎРѓРЎвЂљР Р†РЎС“Р ВµРЎвЂљ Р Р† Р Р…Р С•РЎвЂЎР Р…Р С•Р С Р С—Р ВµРЎР‚Р ВµРЎРѓРЎвЂЎРЎвЂРЎвЂљР Вµ)
  Р С™Р С•Р СР В±./РЎРѓР С‘Р СР Р†.  РІР‚вЂќ Р С—Р В°РЎР‚Р В°Р СР ВµРЎвЂљРЎР‚Р С‘Р В·Р В°РЎвЂ Р С‘Р в„– Р“вЂ” SL Р“вЂ” TP (РЎвЂљР С•Р В»РЎРЉР С”Р С• Р Т‘Р В»РЎРЏ РЎР‚Р ВµР ВµРЎРѓРЎвЂљРЎР‚Р В°)
  Native       РІР‚вЂќ Р СР С•Р Т‘РЎС“Р В»РЎРЉ Р С‘Р СР С—Р С•РЎР‚РЎвЂљР С‘РЎР‚РЎС“Р ВµРЎвЂљРЎРѓРЎРЏ Р С‘Р В· functions.py (РЎР‚Р С•Р Т‘Р Р…Р В°РЎРЏ РЎРѓР ВµРЎвЂљР С”Р В° РЎРѓР ВµР СР ВµР в„–РЎРѓРЎвЂљР Р†)
  Р РЋР ВµР СР ВµР в„–РЎРѓРЎвЂљР Р†Р С•    РІР‚вЂќ Р С”Р В»РЎР‹РЎвЂЎ РЎРѓР ВµР СР ВµР в„–РЎРѓРЎвЂљР Р†Р В° РЎР‚Р С•Р Т‘Р Р…Р С•Р в„– РЎРѓР ВµРЎвЂљР С”Р С‘ (Р ВµРЎРѓР В»Р С‘ РЎС“Р Т‘Р В°Р В»Р С•РЎРѓРЎРЉ РЎРѓР С•Р С—Р С•РЎРѓРЎвЂљР В°Р Р†Р С‘РЎвЂљРЎРЉ)
  Р вЂ™ Р С—Р В»Р В°Р Р…Р Вµ      РІР‚вЂќ РЎвЂљР С‘Р С— Р ВµРЎРѓРЎвЂљРЎРЉ Р Р† journals/active_state.json (РЎвЂљР С•РЎР‚Р С–Р С•Р Р†РЎвЂ№Р в„– Р С—Р В»Р В°Р Р…)
  Р СџР С•Р В·Р С‘РЎвЂ Р С‘РЎРЏ      РІР‚вЂќ Р С—Р С• РЎРЊРЎвЂљР С•Р СРЎС“ РЎвЂљР С‘Р С—РЎС“ Р Р† Р С—Р В»Р В°Р Р…Р Вµ Р ВµРЎРѓРЎвЂљРЎРЉ Р С•РЎвЂљР С”РЎР‚РЎвЂ№РЎвЂљР В°РЎРЏ Р С—Р С•Р В·Р С‘РЎвЂ Р С‘РЎРЏ

Р вЂ™РЎРѓРЎвЂ РЎРѓРЎвЂЎР С‘РЎвЂљР В°Р ВµРЎвЂљРЎРѓРЎРЏ Р Р…Р В° Р СР ВµРЎРѓРЎвЂљР Вµ (РЎвЂћР В°Р в„–Р В»РЎвЂ№ + РЎР‚Р ВµР ВµРЎРѓРЎвЂљРЎР‚ + active_state.json), Р С—Р С•РЎРЊРЎвЂљР С•Р СРЎС“ РЎвЂљР В°Р В±Р В»Р С‘РЎвЂ Р В°
Р Р…Р Вµ РЎР‚Р В°РЎРѓРЎвЂ¦Р С•Р Т‘Р С‘РЎвЂљРЎРѓРЎРЏ РЎРѓ Р С”Р С•Р Т‘Р С•Р С: Р Т‘Р С•Р В±Р В°Р Р†Р С‘Р В»Р С‘ Р СР С•Р Т‘РЎС“Р В»РЎРЉ РІР‚вЂќ Р С—Р С•РЎРЏР Р†Р С‘Р В»Р В°РЎРѓРЎРЉ РЎРѓРЎвЂљРЎР‚Р С•Р С”Р В° РЎРѓ РІСљвЂњ Standalone Р С‘
Р С—РЎС“РЎРѓРЎвЂљРЎвЂ№Р СР С‘ РЎРѓР В»Р С•РЎРЏР СР С‘ Р Р…Р С‘Р В¶Р Вµ, Р С‘ РЎРѓРЎР‚Р В°Р В·РЎС“ Р Р†Р С‘Р Т‘Р Р…Р С•, РЎвЂЎР ВµР С–Р С• Р Р…Р Вµ РЎвЂ¦Р Р†Р В°РЎвЂљР В°Р ВµРЎвЂљ.
"""

from __future__ import annotations

import json
import os
import re

import streamlit as st

HERE = os.path.dirname(os.path.abspath(__file__))
STRAT_DIR = os.path.join(HERE, 'strategies')
JOURNALS_DIR = os.path.join(HERE, 'journals')

# Р В¤Р В°Р в„–Р В»РЎвЂ№, Р С”Р С•РЎвЂљР С•РЎР‚РЎвЂ№Р Вµ Р Р…Р Вµ РЎРЏР Р†Р В»РЎРЏРЎР‹РЎвЂљРЎРѓРЎРЏ РЎРѓРЎвЂљРЎР‚Р В°РЎвЂљР ВµР С–Р С‘РЎРЏР СР С‘: Р С—Р С•Р С”Р В°Р В·РЎвЂ№Р Р†Р В°Р ВµР С Р Р†Р Р…Р С‘Р В·РЎС“ РЎвЂљР В°Р В±Р В»Р С‘РЎвЂ РЎвЂ№, РЎвЂЎРЎвЂљР С•Р В±РЎвЂ№
# Р Р…Р С‘РЎвЂЎР ВµР С–Р С• Р Р…Р Вµ Р’В«Р С—РЎР‚Р С•Р С—Р В°Р Т‘Р В°Р В»Р С•Р’В» Р С‘Р В· РЎРѓР С—Р С‘РЎРѓР С”Р В° Р С—Р В°Р С—Р С”Р С‘.
INFRA = {'__init__.py', 'base.py', '_bt_core.py', '_calc_cache.py', '_registry.py'}

COL_TEXT = '#C9D1D9'
COL_MUTED = '#6E7681'
COL_GREEN_LT = '#3FB950'
COL_AMBER = '#D29922'
COL_RED = '#F85149'
COL_BLUE = '#58A6FF'
COL_BG = '#0D1117'
COL_PANEL = '#161B22'
COL_BORDER = '#21262D'

_CSS = """
