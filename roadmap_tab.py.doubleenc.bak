# РІвЂўС’РІвЂўС’РІвЂўС’РІвЂўС’РІвЂўС’РІвЂўС’РІвЂўС’РІвЂўС’РІвЂўС’РІвЂўС’РІвЂўС’РІвЂўС’РІвЂўС’РІвЂўС’РІвЂўС’РІвЂўС’РІвЂўС’РІвЂўС’РІвЂўС’РІвЂўС’РІвЂўС’РІвЂўС’РІвЂўС’РІвЂўС’РІвЂўС’РІвЂўС’РІвЂўС’ Р ВР РЋР СћР С›Р В§Р СњР ВР С™Р В Р вЂќР С’Р СњР СњР В«Р Тђ РІвЂўС’РІвЂўС’РІвЂўС’РІвЂўС’РІвЂўС’РІвЂўС’РІвЂўС’РІвЂўС’РІвЂўС’РІвЂўС’РІвЂўС’РІвЂўС’РІвЂўС’РІвЂўС’РІвЂўС’РІвЂўС’РІвЂўС’РІвЂўС’РІвЂўС’РІвЂўС’РІвЂўС’РІвЂўС’РІвЂўС’РІвЂўС’РІвЂўС’РІвЂўС’РІвЂўС’
def _read(path: str) -> str:
    try:
        with open(path, 'r', encoding='utf-8', errors='replace') as f:
            return f.read()
    except OSError:
        return ''


def _load_registry():
    """(REGISTRY, ENABLED_BATCH). Р вЂР ВµР В· Р С—Р С•Р В±Р С•РЎвЂЎР Р…РЎвЂ№РЎвЂ¦ РЎРЊРЎвЂћРЎвЂћР ВµР С”РЎвЂљР С•Р Р†: Р СР С•Р Т‘РЎС“Р В»РЎРЉ РЎвЂљР С•Р В»РЎРЉР С”Р С• Р С•Р В±РЎР‰РЎРЏР Р†Р В»РЎРЏР ВµРЎвЂљ Р Т‘Р В°Р Р…Р Р…РЎвЂ№Р Вµ."""
    try:
        import strategies._registry as reg
        return dict(getattr(reg, 'REGISTRY', {}) or {}), set(getattr(reg, 'ENABLED_BATCH', ()) or ())
    except Exception:
        return {}, set()


def _native_modules() -> set:
    """Р СљР С•Р Т‘РЎС“Р В»Р С‘, Р С”Р С•РЎвЂљР С•РЎР‚РЎвЂ№Р Вµ Р С‘Р СР С—Р С•РЎР‚РЎвЂљР С‘РЎР‚РЎС“Р ВµРЎвЂљ functions.py (РЎР‚Р С•Р Т‘Р Р…Р В°РЎРЏ РЎРѓР ВµРЎвЂљР С”Р В° РЎРѓР ВµР СР ВµР в„–РЎРѓРЎвЂљР Р†)."""
    src = _read(os.path.join(HERE, 'functions.py'))
    return set(re.findall(r"from\s+strategies\.(\w+)\s+import", src))


def _native_family_map() -> dict:
    """module -> Р С”Р В»РЎР‹РЎвЂЎ РЎРѓР ВµР СР ВµР в„–РЎРѓРЎвЂљР Р†Р В° РЎР‚Р С•Р Т‘Р Р…Р С•Р в„– РЎРѓР ВµРЎвЂљР С”Р С‘.

    Р РЋР С•Р С—Р С•РЎРѓРЎвЂљР В°Р Р†Р В»Р ВµР Р…Р С‘Р Вµ Р С‘Р Т‘РЎвЂРЎвЂљ Р С—Р С• Р С”Р С•Р Т‘РЎС“ functions.py: Р С•Р В±РЎвЂРЎР‚РЎвЂљР С”Р В° `def _backtest_X(...)` Р В·Р Р…Р В°Р ВµРЎвЂљ
    РЎРѓР Р†Р С•Р в„– Р СР С•Р Т‘РЎС“Р В»РЎРЉ (`from strategies.M import`), Р В° Р Р† Р Р†Р ВµРЎвЂљР С”Р Вµ Р Р†Р С•РЎР‚Р С”Р ВµРЎР‚Р В°
    `if not test_strategy or test_strategy == 'FAM':` Р Р†РЎвЂ№Р В·РЎвЂ№Р Р†Р В°Р ВµРЎвЂљРЎРѓРЎРЏ `_backtest_X`.
    Р СџР В°РЎР‚РЎРѓР С‘Р Р…Р С– Р СРЎРЏР С–Р С”Р С‘Р в„–: Р Р…Р Вµ РЎРѓР В»Р С•Р В¶Р С‘Р В»Р С•РЎРѓРЎРЉ РІР‚вЂќ Р С”Р С•Р В»Р С•Р Р…Р С”Р В° Р С—Р С•Р С”Р В°Р В¶Р ВµРЎвЂљ Р’В«РІР‚вЂќР’В», РЎвЂљР В°Р В±Р В»Р С‘РЎвЂ Р В° Р Р…Р Вµ Р С—Р В°Р Т‘Р В°Р ВµРЎвЂљ.
    """
    src = _read(os.path.join(HERE, 'functions.py'))
    if not src:
        return {}
    wrap2mod = {}
    for chunk in src.split('\ndef ')[1:]:
        head = chunk.split('(')[0].strip()
        if not head.startswith('_backtest_'):
            continue
        m = re.search(r"from\s+strategies\.(\w+)\s+import", chunk)
        if m:
            wrap2mod[head] = m.group(1)
    fam2mod = {}
    for m in re.finditer(
            r"test_strategy\s*==\s*'(\w+)':(.*?)(?=# РІвЂќР‚|if not test_strategy|def |\Z)",
            src, re.S):
        fam, body = m.group(1), m.group(2)
        w = re.search(r"(_backtest_\w+)", body)
        if w and w.group(1) in wrap2mod:
            fam2mod.setdefault(wrap2mod[w.group(1)], fam)
    return fam2mod


def _plan_state():
    """(РЎвЂљР С‘Р С—РЎвЂ№ Р Р† Р С—Р В»Р В°Р Р…Р Вµ, РЎвЂљР С‘Р С—РЎвЂ№ РЎРѓ Р С•РЎвЂљР С”РЎР‚РЎвЂ№РЎвЂљР С•Р в„– Р С—Р С•Р В·Р С‘РЎвЂ Р С‘Р ВµР в„–) Р С‘Р В· journals/active_state.json."""
    path = os.path.join(JOURNALS_DIR, 'active_state.json')
    types, open_types = set(), set()
    try:
        with open(path, 'r', encoding='utf-8') as f:
            data = json.load(f)
        for s in data.get('strategies') or []:
            t = s.get('type') or s.get('family')
            if not t:
                continue
            types.add(str(t))
            if s.get('has_position'):
                open_types.add(str(t))
    except (OSError, ValueError, json.JSONDecodeError):
        pass
    return types, open_types


def _family_scores():
    """score семейств из trades_db.family_score — по ВСЕМ посчитанным комбинациям.

    Зачем отдельно от family_status: там best_score считается по all_results,
    то есть по комбинациям, уже прошедшим дедуп и фильтры рэнкинга. Семейство,
    целиком оказавшееся ниже порога, оставалось вообще без оценки — в таблице
    был прочерк. family_score пишется из чекпойнтов символов, где лежат ВСЕ
    комбинации, поэтому оценка есть всегда: даже отрицательная и даже ниже
    min_score. Такие строки и красим красным.

    Возвращает dict: family -> {'score': среднее best_score по символам,
    'max': лучший символ, 'min': порог отбора, 'combos', 'positive',
    'syms': set(), 'snap': время записи}. Нет таблицы — пустой dict, и тогда
    работает прежний источник (family_status).
    """
    out = {}
    try:
        import trades_db as _tdb
        con = _tdb.connect(readonly=True)
    except Exception:
        return out
    try:
        if not {x[1] for x in con.execute("PRAGMA table_info(family_score)")}:
            return out          # старая БД: таблицы ещё нет — работаем по family_status
        for r in con.execute(
                "SELECT family, symbol, best_score, min_score, n_combos, n_positive, "
                "snapshot_at FROM family_score"):
            fam = str(r['family'] or '')
            if not fam:
                continue
            f = out.setdefault(fam, {'scores': [], 'mins': [], 'combos': 0,
                                     'positive': 0, 'syms': set(), 'snap': ''})
            try:
                f['scores'].append(float(r['best_score'] or 0.0))
            except (TypeError, ValueError):
                pass
            try:
                _m = float(r['min_score'] or 0.0)
                if _m > 0:
                    f['mins'].append(_m)
            except (TypeError, ValueError):
                pass
            f['combos'] += int(r['n_combos'] or 0)
            f['positive'] += int(r['n_positive'] or 0)
            if r['symbol']:
                f['syms'].add(str(r['symbol']))
            f['snap'] = str(r['snapshot_at'] or f['snap'])
    except Exception:
        return out
    finally:
        try:
            con.close()
        except Exception:
            pass
    for f in out.values():
        _sc = f.pop('scores')
        f['score'] = (sum(_sc) / len(_sc)) if _sc else None
        f['max'] = max(_sc) if _sc else None
        _mn = f.pop('mins')
        f['min'] = max(_mn) if _mn else None
    return out


def _run_facts():
    """family РІвЂ вЂ™ РЎвЂћР В°Р С”РЎвЂљРЎвЂ№ Р СџР С›Р РЋР вЂєР вЂўР вЂќР СњР вЂўР вЂњР С› Р С—РЎР‚Р С•Р С–Р С•Р Р…Р В° (trades_db.family_status).

    family_status РІР‚вЂќ РЎРѓР Р…Р С‘Р СР С•Р С” Р С—Р С•РЎРѓР В»Р Вµ РЎР‚РЎРЊР Р…Р С”Р С‘Р Р…Р С–Р В°, Р С•Р Т‘Р Р…Р В° РЎРѓРЎвЂљРЎР‚Р С•Р С”Р В° Р Р…Р В° (symbol, family).
    Р вЂќР В»РЎРЏ Р СР С•Р Т‘РЎС“Р В»РЎРЏ РЎРѓР Р†Р С•РЎР‚Р В°РЎвЂЎР С‘Р Р†Р В°Р ВµР С Р С—Р С• Р Р†РЎРѓР ВµР С РЎРѓР С‘Р СР Р†Р С•Р В»Р В°Р С: Р Р…Р В° РЎРѓР С”Р С•Р В»РЎРЉР С”Р С‘РЎвЂ¦ РЎС“РЎвЂЎР В°РЎРѓРЎвЂљР Р†РЎС“Р ВµРЎвЂљ, РЎРѓР С”Р С•Р В»РЎРЉР С”Р С•
    Р С”Р С•Р СР В±Р С‘Р Р…Р В°РЎвЂ Р С‘Р в„– Р В·Р В°Р С—Р В»Р В°Р Р…Р С‘РЎР‚Р С•Р Р†Р В°Р Р…Р С• Р С‘ РЎР‚Р ВµР В°Р В»РЎРЉР Р…Р С• Р С—Р С•РЎРѓРЎвЂЎР С‘РЎвЂљР В°Р Р…Р С•, Р С–Р Т‘Р Вµ ready_to_trade = 1.

    Р вЂ™Р С•Р В·Р Р†РЎР‚Р В°РЎвЂ°Р В°Р ВµРЎвЂљ (dict, 'YYYY-MM-DD HH:MM' РЎРѓР Р…Р С‘Р СР С”Р В°). Р СњР ВµРЎвЂљ Р вЂР вЂќ/РЎвЂљР В°Р В±Р В»Р С‘РЎвЂ РЎвЂ№ РІР‚вЂќ ({}, '').
    """
    facts, snap = {}, ''
    try:
        import trades_db as _tdb
        con = _tdb.connect(readonly=True)
    except Exception:
        return {}, ''
    try:
        # Р С™Р С•Р В»Р С•Р Р…Р С”Р С‘ Р Р…Р С•Р Р†Р С•Р в„– Р В±Р В°Р В·РЎвЂ№ РЎвЂЎР С‘РЎвЂљР В°Р ВµР С Р С—Р С• РЎвЂћР В°Р С”РЎвЂљРЎС“: Р ВµРЎРѓР В»Р С‘ Р Р† РЎР‚Р В°Р В·Р Р†РЎвЂРЎР‚Р Р…РЎС“РЎвЂљР С•Р в„– Р вЂР вЂќ РЎРѓР Р…Р С‘Р СР С•Р С” РЎРѓРЎвЂљР В°РЎР‚РЎв‚¬Р Вµ
        # (Р Р…Р ВµРЎвЂљ n_ranked/n_active) РІР‚вЂќ Р С—Р С•Р Т‘РЎРѓРЎвЂљР В°Р Р†Р В»РЎРЏР ВµР С NULL, Р В° Р Р…Р Вµ РЎвЂљР ВµРЎР‚РЎРЏР ВµР С Р Р†Р ВµРЎРѓРЎРЉ РЎРѓР Р…Р С‘Р СР С•Р С”.
        _have = {x[1] for x in con.execute("PRAGMA table_info(family_status)")}

        def _c(name):
            return name if name in _have else f"NULL AS {name}"

        for r in con.execute(
                "SELECT family, label, combos_planned, combos_cached, "
                + ", ".join(_c(_n) for _n in (
                    "participates", "ready_to_trade", "snapshot_at", "best_score",
                    "min_score", "run_kind", "symbol", "n_ranked", "n_active"))
                + " FROM family_status"):

            fam = str(r['family'] or '')
            if not fam:
                continue
            f = facts.setdefault(fam, {
                'family': fam, 'label': str(r['label'] or ''),
                'planned': 0, 'cached': 0, 'symbols': 0, 'ready': 0, 'part': 0,
                # score Р С—Р С•РЎРѓР В»Р ВµР Т‘Р Р…Р ВµР С–Р С• РЎР‚РЎРЊР Р…Р С”Р С‘Р Р…Р С–Р В°: best_score Р С—Р С• Р С”Р В°Р В¶Р Т‘Р С•Р СРЎС“ РЎРѓР С‘Р СР Р†Р С•Р В»РЎС“ РЎРѓР ВµР СР ВµР в„–РЎРѓРЎвЂљР Р†Р В°,
                # Р С—Р С•РЎР‚Р С•Р С– min_score Р С—РЎР‚Р С•Р С–Р С•Р Р…Р В°, Р Р†Р С‘Р Т‘ Р С—РЎР‚Р С•Р С–Р С•Р Р…Р В° (full/incremental/...) Р С‘ РЎРѓР С‘Р СР Р†Р С•Р В»РЎвЂ№ РІР‚вЂќ
                # Р Р…РЎС“Р В¶Р Р…РЎвЂ№ Р Т‘Р В»РЎРЏ Р С”Р С•Р В»Р С•Р Р…Р С”Р С‘ Р’В«scoreР’В» Р С‘ Р ВµРЎвЂ РЎвЂ Р Р†Р ВµРЎвЂљР В° (РЎРѓР Р†Р ВµР В¶Р ВµРЎРѓРЎвЂљРЎРЉ Р В±РЎРЊР С”РЎвЂљР ВµРЎРѓРЎвЂљР В°).
                'scores': [], 'mins': [], 'kinds': set(), 'syms': set(),
                # n_ranked/n_active РІР‚вЂќ РЎвЂЎРЎвЂљР С•Р В±РЎвЂ№ РЎвЂЎР ВµРЎРѓРЎвЂљР Р…Р С• РЎРѓР С”Р В°Р В·Р В°РЎвЂљРЎРЉ, Р СџР С›Р В§Р вЂўР СљР Р€ score Р Р…Р ВµРЎвЂљ:
                # РЎРѓРЎвЂљРЎР‚Р С•Р С”Р В° Р ВµРЎРѓРЎвЂљРЎРЉ, Р Р…Р С• Р Р…Р С‘ Р С•Р Т‘Р Р…Р В° Р С”Р С•Р СР В±Р С‘Р Р…Р В°РЎвЂ Р С‘РЎРЏ Р Р…Р Вµ Р С—РЎР‚Р С•РЎв‚¬Р В»Р В° РЎвЂћР С‘Р В»РЎРЉРЎвЂљРЎР‚РЎвЂ№ РЎР‚РЎРЊР Р…Р С”Р С‘Р Р…Р С–Р В°.
                'ranked': 0, 'active': 0,
            })
            f['symbols'] += 1
            f['planned'] += int(r['combos_planned'] or 0)
            f['cached'] += int(r['combos_cached'] or 0)
            f['ranked'] += int(r['n_ranked'] or 0)
            f['active'] += int(r['n_active'] or 0)
            f['ready'] += 1 if r['ready_to_trade'] else 0
            f['part'] += 1 if r['participates'] else 0
            try:
                _bs = float(r['best_score'] or 0.0)
            except (TypeError, ValueError):
                _bs = 0.0
            if _bs > 0:                      # 0 = score Р Р…Р Вµ РЎРѓРЎвЂЎР С‘РЎвЂљР В°Р В»РЎРѓРЎРЏ (РЎРѓРЎвЂљР В°РЎР‚Р В°РЎРЏ РЎРѓРЎвЂљРЎР‚Р С•Р С”Р В°)
                f['scores'].append(_bs)
            try:
                _ms = float(r['min_score'] or 0.0)
            except (TypeError, ValueError):
                _ms = 0.0
            if _ms > 0:
                f['mins'].append(_ms)
            if r['run_kind']:
                f['kinds'].add(str(r['run_kind']))
            if r['symbol']:
                f['syms'].add(str(r['symbol']))
            snap = str(r['snapshot_at'] or snap)
    except Exception:
        return facts, snap
    finally:
        try:
            con.close()
        except Exception:
            pass
    # РЎРЏРЎР‚Р В»РЎвЂ№Р С” Р С”Р В°Р С” Р Р†РЎвЂљР С•РЎР‚Р С•Р в„– Р С”Р В»РЎР‹РЎвЂЎ Р С—Р С•Р С‘РЎРѓР С”Р В° (РЎР‚Р ВµР ВµРЎРѓРЎвЂљРЎР‚ Р С—Р С‘РЎв‚¬Р ВµРЎвЂљ Р Р† Р С—Р В»Р В°Р Р… label, Р В° Р Р…Р Вµ Р С”Р В»РЎР‹РЎвЂЎ)
    for _fam, _f in list(facts.items()):
        _lab = _f.get('label') or ''
        if _lab and _lab not in facts:
            facts[_lab] = _f
    return facts, snap[:16].replace('T', ' ')


def _sl_tp_counts():
    """Р РЋР С”Р С•Р В»РЎРЉР С”Р С• Р В·Р Р…Р В°РЎвЂЎР ВµР Р…Р С‘Р в„– SL Р С‘ TP Р Р† РЎРѓР ВµРЎвЂљР С”Р Вµ config (Р Т‘Р В»РЎРЏ РЎРѓРЎвЂЎРЎвЂРЎвЂљР В° Р С”Р С•Р СР В±Р С‘Р Р…Р В°РЎвЂ Р С‘Р в„–)."""
    try:
        from config import StrategyParams
        sp = StrategyParams()
        return max(1, len(sp.sl_points_list)), max(1, len(sp.tp_points_list))
    except Exception:
        return 3, 3


_CALC_RE = re.compile(r"^def\s+(calc_\w+)\s*\(", re.M)


@st.cache_data(show_spinner=False, ttl=120)
def _scan():
    """Р СџР С•Р В»Р Р…Р В°РЎРЏ Р С‘Р Р…Р Р†Р ВµР Р…РЎвЂљР В°РЎР‚Р С‘Р В·Р В°РЎвЂ Р С‘РЎРЏ: РЎРѓР С—Р С‘РЎРѓР С•Р С” РЎРѓРЎвЂљРЎР‚Р С•Р С” + РЎРѓР Р†Р С•Р Т‘Р С”Р В°. Р С™РЎРЊРЎв‚¬ 2 Р СР С‘Р Р… (РЎвЂћР В°Р в„–Р В»РЎвЂ№ Р СР ВµР Р…РЎРЏРЎР‹РЎвЂљРЎРѓРЎРЏ Р Т‘Р ВµР С—Р В»Р С•Р ВµР С)."""
    registry, enabled = _load_registry()
    mod2keys = {}
    for key, ent in registry.items():
        mod = str((ent or {}).get('module') or '')
        if mod:
            mod2keys.setdefault(mod, []).append(key)
    native_mods = _native_modules()
    native_fam = _native_family_map()
    plan_types, plan_open = _plan_state()
    run_facts, run_snap = _run_facts()
    _fscores = _family_scores()   # score по ВСЕМ комбинациям (включая ниже порога)
    n_sl, n_tp = _sl_tp_counts()

    try:
        names = sorted(n for n in os.listdir(STRAT_DIR) if n.endswith('.py'))
    except OSError:
        names = []

    rows = []
    for fname in names:
        name = fname[:-3]
        src = _read(os.path.join(STRAT_DIR, fname))
        calc = _CALC_RE.search(src)
        keys = mod2keys.get(name, [])
        key = keys[0] if keys else ''
        ent = registry.get(key) or {}
        grid = ent.get('grid') or []
        combos = len(grid) * n_sl * n_tp if grid else 0
        is_reg = bool(key)
        is_enabled = bool(key) and key in enabled
        is_native = name in native_mods
        fam = native_fam.get(name, '')
        _aliases = {a for a in (key, str(ent.get('label') or ''), fam) if a}
        # Р СџР В»Р В°Р Р… Р С—Р С•Р СР ВµРЎвЂЎР В°Р ВµРЎвЂљ РЎвЂљР С‘Р С— Р С”Р В»РЎР‹РЎвЂЎР С•Р С РЎР‚Р ВµР ВµРЎРѓРЎвЂљРЎР‚Р В°, РЎРЏРЎР‚Р В»РЎвЂ№Р С”Р С•Р С Р В»Р С‘Р В±Р С• (Р Т‘Р В»РЎРЏ РЎР‚Р С•Р Т‘Р Р…Р С•Р в„– РЎРѓР ВµРЎвЂљР С”Р С‘) Р С”Р В»РЎР‹РЎвЂЎР С•Р С
        # РЎРѓР ВµР СР ВµР в„–РЎРѓРЎвЂљР Р†Р В° РІР‚вЂќ Р С—РЎР‚Р С•Р Р†Р ВµРЎР‚РЎРЏР ВµР С Р Р†РЎРѓР Вµ РЎвЂљРЎР‚Р С‘, Р С‘Р Р…Р В°РЎвЂЎР Вµ native-Р СР С•Р Т‘РЎС“Р В»Р С‘ Р Т‘Р В°Р Р†Р В°Р В»Р С‘ Р В»Р С•Р В¶Р Р…РЎвЂ№Р в„– Р’В«РІР‚вЂќР’В».
        in_plan = bool(_aliases & plan_types)
        has_pos = bool(_aliases & plan_open)
        # Р СџРЎР‚Р С•Р С–Р С•Р Р… (Р В¤Р С’Р С™Р Сћ): РЎРѓР Р†Р С•РЎР‚Р В°РЎвЂЎР С‘Р Р†Р В°Р ВµР С family_status Р С—Р С• Р Р†РЎРѓР ВµР С РЎРѓР С‘Р СР Р†Р С•Р В»Р В°Р С. Р РЋР С•Р Р†Р С—Р В°Р Т‘Р ВµР Р…Р С‘Р Вµ РІР‚вЂќ
        # Р С—Р С• Р С”Р В»РЎР‹РЎвЂЎРЎС“ РЎР‚Р ВµР ВµРЎРѓРЎвЂљРЎР‚Р В°, РЎРЏРЎР‚Р В»РЎвЂ№Р С”РЎС“ Р С‘Р В»Р С‘ РЎР‚Р С•Р Т‘Р Р…Р С•Р СРЎС“ РЎРѓР ВµР СР ВµР в„–РЎРѓРЎвЂљР Р†РЎС“; identity РІР‚вЂќ family-РЎРѓРЎвЂљРЎР‚Р С•Р С”Р В°,
        # Р С‘Р Р…Р В°РЎвЂЎР Вµ Р С•Р Т‘Р С‘Р Р… Р СР С•Р Т‘РЎС“Р В»РЎРЉ Р СР С•Р С– Р В±РЎвЂ№ Р С—Р С•РЎРѓРЎвЂЎР С‘РЎвЂљР В°РЎвЂљРЎРЉРЎРѓРЎРЏ Р Т‘Р Р†Р В°Р В¶Р Т‘РЎвЂ№ (Р С”Р В»РЎР‹РЎвЂЎ + РЎРЏРЎР‚Р В»РЎвЂ№Р С”).
        _rkeys = {run_facts[a]['family'] for a in _aliases if a in run_facts}
        _rsym = _rplanned = _rcached = _rready = _rpart = 0
        for _fk in _rkeys:
            _rf = run_facts[_fk]
            _rsym += int(_rf['symbols'])
            _rplanned += int(_rf['planned'])
            _rcached += int(_rf['cached'])
            _rready += int(_rf['ready'])
            _rpart += int(_rf['part'])
        _rcov = (100.0 * _rcached / _rplanned) if _rplanned > 0 else None

        # РІвЂќР‚РІвЂќР‚ score РЎРѓР ВµР СР ВµР в„–РЎРѓРЎвЂљР Р†Р В° Р Р…Р В° Р С—Р С•РЎРѓР В»Р ВµР Т‘Р Р…Р ВµР С РЎР‚РЎРЊР Р…Р С”Р С‘Р Р…Р С–Р Вµ РІвЂќР‚РІвЂќР‚РІвЂќР‚РІвЂќР‚РІвЂќР‚РІвЂќР‚РІвЂќР‚РІвЂќР‚РІвЂќР‚РІвЂќР‚РІвЂќР‚РІвЂќР‚РІвЂќР‚РІвЂќР‚РІвЂќР‚РІвЂќР‚РІвЂќР‚РІвЂќР‚РІвЂќР‚РІвЂќР‚РІвЂќР‚РІвЂќР‚РІвЂќР‚РІвЂќР‚РІвЂќР‚РІвЂќР‚РІвЂќР‚РІвЂќР‚РІвЂќР‚
        # Р РЋРЎвЂљРЎР‚Р В°РЎвЂљР ВµР С–Р С‘РЎРЏ Р Р† Р С—Р В»Р В°Р Р…Р Вµ Р В°РЎвЂљР С•Р СР В°РЎР‚Р Р…Р В°, Р В° РЎРѓРЎвЂљРЎР‚Р С•Р С”Р В° РЎвЂљР В°Р В±Р В»Р С‘РЎвЂ РЎвЂ№ РІР‚вЂќ РЎРѓР ВµР СР ВµР в„–РЎРѓРЎвЂљР Р†Р С• (Р СР С•Р Т‘РЎС“Р В»РЎРЉ).
        # Р С’Р С–РЎР‚Р ВµР С–Р В°РЎвЂ Р С‘РЎРЏ: РЎРѓРЎР‚Р ВµР Т‘Р Р…Р ВµР Вµ best_score Р С—Р С• РЎРѓР С‘Р СР Р†Р С•Р В»Р В°Р С РЎРѓР ВµР СР ВµР в„–РЎРѓРЎвЂљР Р†Р В° (best_score Р С”Р В°Р В¶Р Т‘Р С•Р в„–
        # РЎРѓРЎвЂљРЎР‚Р С•Р С”Р С‘ family_status РІР‚вЂќ Р вЂєР Р€Р В§Р РЃР С’Р Р‡ Р С”Р С•Р СР В±Р С‘Р Р…Р В°РЎвЂ Р С‘РЎРЏ РЎРѓР ВµР СР ВµР в„–РЎРѓРЎвЂљР Р†Р В° Р Р…Р В° РЎРЊРЎвЂљР С•Р С РЎРѓР С‘Р СР Р†Р С•Р В»Р Вµ).
        # Р В¦Р Р†Р ВµРЎвЂљ РІР‚вЂќ Р’В«Р Т‘Р В°РЎвЂљР В° РЎРѓР С”Р С•РЎР‚Р С‘Р Р…Р С–Р В° == Р Т‘Р В°РЎвЂљР В° Р В±РЎРЊР С”РЎвЂљР ВµРЎРѓРЎвЂљР В°Р’В»:
        #   Р В·Р ВµР В»РЎвЂР Р…РЎвЂ№Р в„– РІР‚вЂќ Р С”Р С•Р СР В±Р С‘Р Р…Р В°РЎвЂ Р С‘Р С‘ РЎРѓР ВµР СР ВµР в„–РЎРѓРЎвЂљР Р†Р В° Р С—Р С•РЎРѓРЎвЂЎР С‘РЎвЂљР В°Р Р…РЎвЂ№ Р СџР С›Р вЂєР СњР С›Р РЋР СћР В¬Р В® Р Р† Р С—Р С•РЎРѓР В»Р ВµР Т‘Р Р…Р ВµР С
        #             Р С—РЎР‚Р С•Р С–Р С•Р Р…Р Вµ (Р С—Р С•Р С”РЎР‚РЎвЂ№РЎвЂљР С‘Р Вµ РІвЂ°Тђ 99.5%): score РЎРѓРЎвЂљР С•Р С‘РЎвЂљ Р Р…Р В° РЎРѓР Р†Р ВµР В¶Р С‘РЎвЂ¦ Р Т‘Р В°Р Р…Р Р…РЎвЂ№РЎвЂ¦;
        #   Р В¶РЎвЂР В»РЎвЂљРЎвЂ№Р в„–  РІР‚вЂќ Р С—Р С•Р С”РЎР‚РЎвЂ№РЎвЂљР С‘Р Вµ < 100%: РЎвЂЎР В°РЎРѓРЎвЂљРЎРЉ Р С”Р С•Р СР В±Р С‘Р Р…Р В°РЎвЂ Р С‘Р в„– Р С‘Р В· Р С”РЎРЊРЎв‚¬Р В°, РЎвЂљ.Р Вµ. Р В±РЎРЊР С”РЎвЂљР ВµРЎРѓРЎвЂљ
        #             РЎРѓР ВµР СР ВµР в„–РЎРѓРЎвЂљР Р†Р В° РЎРѓРЎвЂљР В°РЎР‚РЎв‚¬Р Вµ Р Т‘Р В°РЎвЂљРЎвЂ№ РЎРѓР С”Р С•РЎР‚Р С‘Р Р…Р С–Р В°;

        #   Р’В«РІР‚вЂќР’В»     РІР‚вЂќ score Р Р…Р ВµРЎвЂљ (РЎРѓР ВµР СР ВµР в„–РЎРѓРЎвЂљР Р†Р В° Р Р…Р ВµРЎвЂљ Р Р† РЎРѓР Р…Р С‘Р СР С”Р Вµ Р В»Р С‘Р В±Р С• n_ranked = 0).
        # run_kind Р СњР вЂў Р С–Р ВµР в„–РЎвЂљ: РЎР‚РЎС“РЎвЂљР С‘Р Р…Р В° Р С‘Р Т‘РЎвЂРЎвЂљ incremental/incomplete, Р С‘ Р Р…Р В° Р Р…РЎвЂР С РЎРѓРЎвЂљР С•Р В»Р В±Р ВµРЎвЂ 
        # Р В±РЎвЂ№Р В» Р В±РЎвЂ№ Р В¶РЎвЂР В»РЎвЂљРЎвЂ№Р С Р Т‘Р В°Р В¶Р Вµ Р С—РЎР‚Р С‘ 100% Р С—Р С•Р С”РЎР‚РЎвЂ№РЎвЂљР С‘Р С‘ Р С”Р С•Р СР В±Р С‘Р Р…Р В°РЎвЂ Р С‘Р в„–.
        _rscore, _rmin, _rkinds, _rsyms = [], [], set(), set()
        _rranked = _ractive = 0
        for _fk in _rkeys:
            _rf = run_facts[_fk]
            _rscore += list(_rf.get('scores') or [])
            _rmin += list(_rf.get('mins') or [])
            _rkinds |= set(_rf.get('kinds') or ())
            _rsyms |= set(_rf.get('syms') or ())
            _rranked += int(_rf.get('ranked') or 0)
            _ractive += int(_rf.get('active') or 0)
        _score = (sum(_rscore) / len(_rscore)) if _rscore else None
        _score_max = max(_rscore) if _rscore else None
        _min_score = max(_rmin) if _rmin else None
        # score из family_score (все комбинации) приоритетнее family_status:
        # там оценка есть и у семейства, целиком оказавшегося ниже порога.
        _fs = [_fscores[k] for k in _rkeys
               if k in _fscores and _fscores[k].get('score') is not None]
        if _fs:
            _score = sum(x['score'] for x in _fs) / len(_fs)
            _score_max = max((x['max'] for x in _fs if x['max'] is not None), default=None)
            _fs_min = max((x['min'] for x in _fs if x['min'] is not None), default=None)
            if _fs_min is not None:
                _min_score = _fs_min
            _score_src = 'family_score'
            _score_combos = sum(x['combos'] for x in _fs)
            _score_pos = sum(x['positive'] for x in _fs)
        else:
            _score_src = 'family_status'
            _score_combos = None
            _score_pos = None
        _score_fresh = bool(_score is not None
                            and _rcov is not None and _rcov >= 99.5)
        # Р СџРЎР‚Р С•Р В·РЎР‚Р В°РЎвЂЎР Р…Р В°РЎРЏ Р С—РЎР‚Р С‘РЎвЂЎР С‘Р Р…Р В° Р С—РЎС“РЎРѓРЎвЂљР С•Р С–Р С• score РІР‚вЂќ РЎС“РЎвЂ¦Р С•Р Т‘Р С‘РЎвЂљ Р Р† Р С—Р С•Р Т‘РЎРѓР С”Р В°Р В·Р С”РЎС“ Р С”РЎС“РЎР‚РЎРѓР С•РЎР‚Р С•Р С.
        if _score is not None:
            _score_reason = ''
        elif not _rkeys:
            _score_reason = ('Р Р…Р ВµРЎвЂљ РЎРѓРЎвЂљРЎР‚Р С•Р С”Р С‘ Р Р† family_status: РЎРѓР ВµР СР ВµР в„–РЎРѓРЎвЂљР Р†Р С• Р Р…Р Вµ Р С—Р С•Р С—Р В°Р В»Р С• Р Р† Р С—Р В»Р В°Р Р… '
                             'Р С—Р С•РЎРѓР В»Р ВµР Т‘Р Р…Р ВµР С–Р С• Р С—РЎР‚Р С•Р С–Р С•Р Р…Р В°')
        elif _rranked <= 0:
            _score_reason = ('score Р Р…Р Вµ РЎРѓРЎвЂЎР С‘РЎвЂљР В°Р В»РЎРѓРЎРЏ: Р Р…Р С‘ Р С•Р Т‘Р Р…Р В° Р С”Р С•Р СР В±Р С‘Р Р…Р В°РЎвЂ Р С‘РЎРЏ РЎРѓР ВµР СР ВµР в„–РЎРѓРЎвЂљР Р†Р В° Р Р…Р Вµ '
                             'Р С—РЎР‚Р С•РЎв‚¬Р В»Р В° РЎвЂћР С‘Р В»РЎРЉРЎвЂљРЎР‚РЎвЂ№ РЎР‚РЎРЊР Р…Р С”Р С‘Р Р…Р С–Р В° (n_ranked = 0)')
        else:
            _score_reason = f'score Р С—РЎС“РЎРѓРЎвЂљР С•Р в„– Р С—РЎР‚Р С‘ n_ranked = {_rranked}'
        # Р РЋР С•РЎРѓРЎвЂљР С•РЎРЏР Р…Р С‘Р Вµ score Р Т‘Р В»РЎРЏ РЎвЂ Р Р†Р ВµРЎвЂљР В° РЎРЏРЎвЂЎР ВµР в„–Р С”Р С‘:
        #   red   РІР‚вЂќ Р В±РЎРЊР С”РЎвЂљР ВµРЎРѓРЎвЂљ Р вЂўР РЋР СћР В¬, Р Р…Р С• Р С”Р С•Р СР В±Р С‘Р Р…Р В°РЎвЂ Р С‘Р С‘ Р Р…Р Вµ Р С—РЎР‚Р С•РЎв‚¬Р В»Р С‘ Р С—Р С•РЎР‚Р С•Р С– Р С•РЎвЂљР В±Р С•РЎР‚Р В°: Р В»Р С‘Р В±Р С•
        #           Р Р…Р С‘ Р С•Р Т‘Р Р…Р В° (n_ranked = 0 РІвЂ вЂ™ Р Р† Р В±Р В°Р В·Р Вµ best_score = 0), Р В»Р С‘Р В±Р С•
        #           Р В»РЎС“РЎвЂЎРЎв‚¬Р С‘Р в„– score Р Р…Р С‘Р В¶Р Вµ min_score Р С—РЎР‚Р С•Р С–Р С•Р Р…Р В°. Р СћР В°Р С”Р С‘Р Вµ РЎРѓРЎвЂљРЎР‚Р С•Р С”Р С‘ РІР‚вЂќ
        #           Р’В«РЎРѓРЎвЂљРЎР‚Р В°РЎвЂљР ВµР С–Р С‘РЎРЏ Р С—Р С•РЎРѓРЎвЂЎР С‘РЎвЂљР В°Р Р…Р В°, Р Р…Р С• Р Р…Р С‘Р В¶Р Вµ РЎвЂћР С‘Р В»РЎРЉРЎвЂљРЎР‚Р С•Р Р†Р’В», Р С‘РЎвЂ¦ Р Р†Р С‘Р Т‘Р Р…Р С• Р С”РЎР‚Р В°РЎРѓР Р…РЎвЂ№Р С.
        #   green РІР‚вЂќ score Р Р†РЎвЂ№РЎв‚¬Р Вµ Р С—Р С•РЎР‚Р С•Р С–Р В° Р С‘ Р С—Р С•Р С”РЎР‚РЎвЂ№РЎвЂљР С‘Р Вµ Р С—Р С•Р В»Р Р…Р С•Р Вµ (score = РЎРѓР Р†Р ВµР В¶Р С‘Р в„– Р В±РЎРЊР С”РЎвЂљР ВµРЎРѓРЎвЂљ);
        #   amber РІР‚вЂќ score Р Р†РЎвЂ№РЎв‚¬Р Вµ Р С—Р С•РЎР‚Р С•Р С–Р В°, Р Р…Р С• Р С—Р С•Р С”РЎР‚РЎвЂ№РЎвЂљР С‘Р Вµ < 100% (РЎвЂЎР В°РЎРѓРЎвЂљРЎРЉ Р С‘Р В· Р С”РЎРЊРЎв‚¬Р В°);
        #   none  РІР‚вЂќ score Р Р…Р ВµРЎвЂљ Р Р†Р С•Р Р†РЎРѓР Вµ (Р Р…Р Вµ Р В±РЎРЊР С”РЎвЂљР ВµРЎРѓРЎвЂљР С‘Р В»Р С•РЎРѓРЎРЉ / Р Р…Р ВµРЎвЂљ РЎРѓР Р…Р С‘Р СР С”Р В°).
        if _score is not None and _min_score is not None and _score < _min_score:
            _score_state = 'red'
        elif _score is not None:
            _score_state = 'green' if _score_fresh else 'amber'
        elif _rkeys and _rplanned > 0 and _rcached > 0 and _rranked <= 0:
            _score_state = 'red'   # Р С—Р С•РЎРѓРЎвЂЎР С‘РЎвЂљР В°Р Р…Р С•, Р Р…Р С• Р Р†РЎРѓРЎвЂ Р С•РЎвЂљРЎвЂћР С‘Р В»РЎРЉРЎвЂљРЎР‚Р С•Р Р†Р В°Р Р…Р С• Р С—Р С•РЎР‚Р С•Р С–Р В°Р СР С‘
        else:
            _score_state = 'none'
        rows.append({
            'file': fname,
            'module': name,
            'infra': fname in INFRA,
            'calc': calc.group(1) if calc else '',
            'entry': 'def check_entry' in src,
            'exit': 'def check_exit' in src,
            'bt': 'def backtest' in src,
            'key': key,
            'label': str(ent.get('label') or ''),
            'reg': is_reg,
            'enabled': is_enabled,
            'combos': combos,
            'native': is_native,
            'fam': fam,
            'plan': in_plan,
            'pos': has_pos,
            'rsym': _rsym,
            'rplanned': _rplanned,
            'rcached': _rcached,
            'rready': _rready,
            'rpart': _rpart,
            'rcov': _rcov,
            'score': _score,                        # РЎРѓРЎР‚Р ВµР Т‘Р Р…Р ВµР Вµ best_score Р С—Р С• РЎРѓР С‘Р СР Р†Р С•Р В»Р В°Р С
            'score_max': _score_max,
            'min_score': _min_score,
            'score_fresh': _score_fresh,
            'score_state': _score_state,
            'score_src': _score_src,        # family_score (все комбинации) | family_status
            'score_combos': _score_combos,  # сколько комбинаций посчитано
            'score_pos': _score_pos,        # сколько из них со score > 0
            'run_kinds': sorted(_rkinds),
            'score_syms': len(_rsyms),
            'score_reason': _score_reason,
            'n_ranked': _rranked,
            'n_active': _ractive,
            'bytes': len(src),
        })

    # Р СџР С•РЎР‚РЎРЏР Т‘Р С•Р С”: РЎР‚Р С•Р Т‘Р Р…РЎвЂ№Р Вµ РІвЂ вЂ™ РЎР‚Р ВµР ВµРЎРѓРЎвЂљРЎР‚ РІвЂ вЂ™ Р С”Р В°Р Р…Р Т‘Р С‘Р Т‘Р В°РЎвЂљРЎвЂ№; Р С‘Р Р…РЎвЂћРЎР‚Р В°РЎРѓРЎвЂљРЎР‚РЎС“Р С”РЎвЂљРЎС“РЎР‚Р В° Р Р†РЎРѓР ВµР С–Р Т‘Р В° Р Р† Р С”Р С•Р Р…РЎвЂ Р Вµ.
    def _ord(r):
        tier = 0 if r['native'] else (1 if r['reg'] else 2)
        return (1 if r['infra'] else 0, tier, r['module'])

    rows.sort(key=_ord)

    # Р С™Р В°Р С”Р С‘Р Вµ Р Р†Р С‘Р Т‘РЎвЂ№ Р С—РЎР‚Р С•Р С–Р С•Р Р…Р В° Р Р†Р С•Р С•Р В±РЎвЂ°Р Вµ Р С—Р С‘РЎРѓР В°Р В»Р С‘РЎРѓРЎРЉ Р Р† РЎРѓР Р…Р С‘Р СР С•Р С” (Р Т‘Р В»РЎРЏ Р С—Р С•Р Т‘Р С—Р С‘РЎРѓР С‘ Р С—Р С•Р Т‘ РЎвЂљР В°Р В±Р В»Р С‘РЎвЂ Р ВµР в„–):
    # Р Р† РЎР‚РЎС“РЎвЂљР С‘Р Р…Р Вµ РЎРЊРЎвЂљР С• Р С•Р В±РЎвЂ№РЎвЂЎР Р…Р С• none/incomplete РІР‚вЂќ Р С—Р С•РЎРЊРЎвЂљР С•Р СРЎС“ run_kind Р Р…Р Вµ Р С–Р ВµР в„–РЎвЂљ Р Т‘Р В»РЎРЏ РЎвЂ Р Р†Р ВµРЎвЂљР В°.
    _all_kinds = sorted({k for _f in run_facts.values()
                         for k in (_f.get('kinds') or ())})

    stat = {
        'files': len(rows),
        'infra': sum(1 for r in rows if r['infra']),
        'reg': sum(1 for r in rows if r['reg']),
        'enabled': sum(1 for r in rows if r['enabled']),
        'native': sum(1 for r in rows if r['native']),
        'plan': sum(1 for r in rows if r['plan']),
        'gap': sum(1 for r in rows if not r['infra'] and not r['reg'] and not r['native']),
        'combos': sum(r['combos'] for r in rows if r['enabled']),
        'n_sl': n_sl,
        'n_tp': n_tp,
        'in_run': sum(1 for r in rows if r['rsym']),
        'ready': sum(1 for r in rows if r['rready']),
        'run_snap': run_snap,
        'run_kinds': _all_kinds,
        'n_score': sum(1 for r in rows if r['score'] is not None),
    }
    return rows, stat


# РІвЂўС’РІвЂўС’РІвЂўС’РІвЂўС’РІвЂўС’РІвЂўС’РІвЂўС’РІвЂўС’РІвЂўС’РІвЂўС’РІвЂўС’РІвЂўС’РІвЂўС’РІвЂўС’РІвЂўС’РІвЂўС’РІвЂўС’РІвЂўС’РІвЂўС’РІвЂўС’РІвЂўС’РІвЂўС’РІвЂўС’РІвЂўС’РІвЂўС’РІвЂўС’РІвЂўС’ Р В Р вЂўР СњР вЂќР вЂўР В  РІвЂўС’РІвЂўС’РІвЂўС’РІвЂўС’РІвЂўС’РІвЂўС’РІвЂўС’РІвЂўС’РІвЂўС’РІвЂўС’РІвЂўС’РІвЂўС’РІвЂўС’РІвЂўС’РІвЂўС’РІвЂўС’РІвЂўС’РІвЂўС’РІвЂўС’РІвЂўС’РІвЂўС’РІвЂўС’РІвЂўС’РІвЂўС’РІвЂўС’РІвЂўС’РІвЂўС’
def _cell(flag: bool, text: str = 'РІСљвЂњ', no: str = 'РІР‚вЂќ') -> str:
    if flag:
        return (f"<td style='text-align:center;color:{COL_GREEN_LT};"
                f"font-weight:700;'>{text}</td>")
    return f"<td style='text-align:center;color:{COL_MUTED};'>{no}</td>"


def _num(n: int) -> str:
    return f"{n:,}".replace(',', ' ')


def _stats_html(stat: dict) -> str:
    _KEEP = {'Standalone': 1, 'Finalized': 2, 'In plan': 3}  # Р С—Р С•РЎР‚РЎРЏР Т‘Р С•Р С” Р В·Р В°Р Т‘Р В°РЎвЂРЎвЂљ CSS order
    def cell(label, value, color=COL_TEXT, hint=''):
        if label not in _KEEP:
            return ''
        title = f" title='{hint}'" if hint else ''
        return (f"<div style='order:{_KEEP[label]};'><div class='lbl'{title}>{label}</div>"
                f"<div class='val' style='color:{color};'>{value}</div></div>")

    html = ["<div class='rdm-stats'>"]
    html.append(cell('Р В¤Р В°Р в„–Р В»Р С•Р Р† .py', _num(stat['files']),
                     hint='Р вЂ™РЎРѓР Вµ .py Р Р† strategies/, Р Р†Р С”Р В»РЎР‹РЎвЂЎР В°РЎРЏ Р С‘Р Р…РЎвЂћРЎР‚Р В°РЎРѓРЎвЂљРЎР‚РЎС“Р С”РЎвЂљРЎС“РЎР‚Р Р…РЎвЂ№Р Вµ'))
    html.append(cell('Standalone', _num(stat['files'] - stat['infra']),
                     COL_GREEN_LT, 'Р СљР С•Р Т‘РЎС“Р В»Р С‘-РЎРѓРЎвЂљРЎР‚Р В°РЎвЂљР ВµР С–Р С‘Р С‘ (Р В±Р ВµР В· base/_bt_core/_calc_cache/_registry)'))
    html.append(cell('Р вЂ™ РЎР‚Р ВµР ВµРЎРѓРЎвЂљРЎР‚Р Вµ', _num(stat['reg']), COL_BLUE,
                     'Р вЂўРЎРѓРЎвЂљРЎРЉ Р В·Р В°Р С—Р С‘РЎРѓРЎРЉ Р Р† strategies/_registry.py РІвЂ вЂ™ REGISTRY'))
    html.append(cell('Р вЂ™ Р В±Р В°РЎвЂљРЎвЂЎР Вµ', _num(stat['enabled']), COL_GREEN_LT,
                     'Р С™Р В»РЎР‹РЎвЂЎ Р Р† ENABLED_BATCH РІР‚вЂќ РЎС“РЎвЂЎР В°РЎРѓРЎвЂљР Р†РЎС“Р ВµРЎвЂљ Р Р† Р Р…Р С•РЎвЂЎР Р…Р С•Р С Р С—Р ВµРЎР‚Р ВµРЎРѓРЎвЂЎРЎвЂРЎвЂљР Вµ'))
    html.append(cell('Native', _num(stat['native']), COL_AMBER,
                     'Р ВР СР С—Р С•РЎР‚РЎвЂљР С‘РЎР‚РЎС“Р ВµРЎвЂљРЎРѓРЎРЏ Р С‘Р В· functions.py РІР‚вЂќ РЎР‚Р С•Р Т‘Р Р…Р В°РЎРЏ РЎРѓР ВµРЎвЂљР С”Р В° РЎРѓР ВµР СР ВµР в„–РЎРѓРЎвЂљР Р†'))
    html.append(cell('In plan', _num(stat['plan']), COL_TEXT,
                     'Р СћР С‘Р С— Р Р†РЎРѓРЎвЂљРЎР‚Р ВµРЎвЂЎР В°Р ВµРЎвЂљРЎРѓРЎРЏ Р Р† journals/active_state.json'))
    html.append(cell('Finalized', _num(stat.get('in_run', 0)), COL_BLUE,
                     'Р СљР С•Р Т‘РЎС“Р В»РЎРЉ Р ВµРЎРѓРЎвЂљРЎРЉ Р Р† family_status Р С—Р С•РЎРѓР В»Р ВµР Т‘Р Р…Р ВµР С–Р С• РЎР‚РЎРЊР Р…Р С”Р С‘Р Р…Р С–Р В° ' +
                     (stat.get('run_snap') or 'РІР‚вЂќ')))
    html.append(cell('Р вЂњР С•РЎвЂљР С•Р Р†РЎвЂ№ РЎвЂљР С•РЎР‚Р С–Р С•Р Р†Р В°РЎвЂљРЎРЉ', _num(stat.get('ready', 0)), COL_GREEN_LT,
                     'ready_to_trade = 1 РЎвЂ¦Р С•РЎвЂљРЎРЏ Р В±РЎвЂ№ Р Р…Р В° Р С•Р Т‘Р Р…Р С•Р С РЎРѓР С‘Р СР Р†Р С•Р В»Р Вµ'))
    if stat['gap']:
        html.append(cell('Р СњР Вµ Р С—Р С•Р Т‘Р С”Р В»РЎР‹РЎвЂЎР ВµР Р…Р С•', _num(stat['gap']), COL_MUTED,
                         'Р СњР ВµРЎвЂљ Р Р…Р С‘ Р Р† РЎР‚Р ВµР ВµРЎРѓРЎвЂљРЎР‚Р Вµ, Р Р…Р С‘ Р Р† РЎР‚Р С•Р Т‘Р Р…Р С•Р в„– РЎРѓР ВµРЎвЂљР С”Р Вµ'))
    html.append(cell('РћР€ Р С”Р С•Р СР В±./РЎРѓР С‘Р СР Р†.', _num(stat['combos']),
                     hint=f"Р СћР С•Р В»РЎРЉР С”Р С• Р В±Р В°РЎвЂљРЎвЂЎ РЎР‚Р ВµР ВµРЎРѓРЎвЂљРЎР‚Р В°: Р С—Р В°РЎР‚Р В°Р СР ВµРЎвЂљРЎР‚Р С‘Р В·Р В°РЎвЂ Р С‘Р С‘ Р“вЂ” {stat['n_sl']} SL Р“вЂ” "
                          f"{stat['n_tp']} TP"))
    html.append("</div>")
    return ''.join(html)


def _score_cell(r: dict) -> str:
    """Р С™Р С•Р В»Р С•Р Р…Р С”Р В° Р’В«scoreР’В» РІР‚вЂќ Р С•РЎвЂ Р ВµР Р…Р С”Р В° РЎРѓР ВµР СР ВµР в„–РЎРѓРЎвЂљР Р†Р В° Р Р…Р В° Р СџР С›Р РЋР вЂєР вЂўР вЂќР СњР вЂўР Сљ РЎР‚РЎРЊР Р…Р С”Р С‘Р Р…Р С–Р Вµ (family_status.best_score).

    Р РЋРЎвЂљРЎР‚Р С•Р С”Р В° РЎвЂљР В°Р В±Р В»Р С‘РЎвЂ РЎвЂ№ РІР‚вЂќ РЎРѓР ВµР СР ВµР в„–РЎРѓРЎвЂљР Р†Р С• (Р СР С•Р Т‘РЎС“Р В»РЎРЉ), Р В° score Р Р† Р В±Р В°Р В·Р Вµ РЎРѓРЎвЂЎР С‘РЎвЂљР В°Р ВµРЎвЂљРЎРѓРЎРЏ Р Р…Р В° Р С—Р В°РЎР‚РЎС“
    (symbol, family): Р С—Р С•Р С”Р В°Р В·РЎвЂ№Р Р†Р В°Р ВµР С РЎРѓРЎР‚Р ВµР Т‘Р Р…Р ВµР Вµ best_score Р С—Р С• РЎРѓР С‘Р СР Р†Р С•Р В»Р В°Р С РЎРѓР ВµР СР ВµР в„–РЎРѓРЎвЂљР Р†Р В°,
    Р СР В°Р С”РЎРѓР С‘Р СРЎС“Р С Р С‘ Р С—Р С•РЎР‚Р С•Р С– Р С—РЎР‚Р С•Р С–Р С•Р Р…Р В° РІР‚вЂќ Р Р† Р С—Р С•Р Т‘РЎРѓР С”Р В°Р В·Р С”Р Вµ.

    Р В¦Р Р†Р ВµРЎвЂљ РІР‚вЂќ РЎРѓР С•Р С•РЎвЂљР Р†Р ВµРЎвЂљРЎРѓРЎвЂљР Р†Р С‘Р Вµ РЎРѓР С”Р С•РЎР‚Р С‘Р Р…Р С–Р В° Р Т‘Р В°РЎвЂљР Вµ Р В±РЎРЊР С”РЎвЂљР ВµРЎРѓРЎвЂљР В°:
      Р В·Р ВµР В»РЎвЂР Р…РЎвЂ№Р в„– РІР‚вЂќ Р С”Р С•Р СР В±Р С‘Р Р…Р В°РЎвЂ Р С‘Р С‘ РЎРѓР ВµР СР ВµР в„–РЎРѓРЎвЂљР Р†Р В° Р С—Р С•РЎРѓРЎвЂЎР С‘РЎвЂљР В°Р Р…РЎвЂ№ Р СџР С›Р вЂєР СњР С›Р РЋР СћР В¬Р В® Р Р† Р С—Р С•РЎРѓР В»Р ВµР Т‘Р Р…Р ВµР С Р С—РЎР‚Р С•Р С–Р С•Р Р…Р Вµ
                (Р С—Р С•Р С”РЎР‚РЎвЂ№РЎвЂљР С‘Р Вµ РІвЂ°Тђ 99.5%): score Р С‘ Р В±РЎРЊР С”РЎвЂљР ВµРЎРѓРЎвЂљ Р С‘Р В· Р С•Р Т‘Р Р…Р С•Р С–Р С• Р С—РЎР‚Р С•Р С–Р С•Р Р…Р В°;
      Р В¶РЎвЂР В»РЎвЂљРЎвЂ№Р в„–  РІР‚вЂќ Р С—Р С•Р С”РЎР‚РЎвЂ№РЎвЂљР С‘Р Вµ < 100%: РЎвЂЎР В°РЎРѓРЎвЂљРЎРЉ Р С”Р С•Р СР В±Р С‘Р Р…Р В°РЎвЂ Р С‘Р в„– Р Р†Р В·РЎРЏРЎвЂљР В° Р С‘Р В· Р С”РЎРЊРЎв‚¬Р В°, РЎвЂљ.Р Вµ. Р Т‘Р В°Р Р…Р Р…РЎвЂ№Р Вµ
                Р В±РЎРЊР С”РЎвЂљР ВµРЎРѓРЎвЂљР В° РЎРѓРЎвЂљР В°РЎР‚РЎв‚¬Р Вµ Р Т‘Р В°РЎвЂљРЎвЂ№ РЎРѓР С”Р С•РЎР‚Р С‘Р Р…Р С–Р В°;
      Р’В«РІР‚вЂќР’В»     РІР‚вЂќ score Р Р…Р Вµ РЎРѓРЎвЂЎР С‘РЎвЂљР В°Р В»РЎРѓРЎРЏ.
    """
    sc = r.get('score')
    _state = r.get('score_state') or ('none' if sc is None else 'amber')
    if _state == 'red' and sc is None:
        sc = 0.0   # посчитано, но ни одна комбинация не прошла порог → score 0
    if sc is None:
        _why = r.get('score_reason') or 'score Р Р…Р Вµ РЎРѓРЎвЂЎР С‘РЎвЂљР В°Р В»РЎРѓРЎРЏ'
        return (f"<td style='text-align:center;color:{COL_MUTED};' "
                f"title='{_why}'>РІР‚вЂќ</td>")

    _state_colors = {'green': COL_GREEN_LT, 'amber': COL_AMBER, 'red': COL_RED}
    color = _state_colors.get(_state, COL_AMBER)
    _kinds = ', '.join(r.get('run_kinds') or []) or 'РІР‚вЂќ'
    _min_s = r.get('min_score')
    _min_txt = f"{_min_s:.2f}" if isinstance(_min_s, (int, float)) else 'РІР‚вЂќ'
    _max_s = r.get('score_max')
    _max_txt = f"{_max_s:.2f}" if isinstance(_max_s, (int, float)) else 'РІР‚вЂќ'
    cov = r.get('rcov')
    tip = (f"score {sc:.2f} (РЎРѓРЎР‚Р ВµР Т‘Р Р…Р ВµР Вµ best_score Р С—Р С• {r.get('score_syms', 0)} РЎРѓР С‘Р СР Р†Р С•Р В»Р В°Р С, "
           f"Р СР В°Р С”РЎРѓ {_max_txt}); Р С—Р С•РЎР‚Р С•Р С– Р С—РЎР‚Р С•Р С–Р С•Р Р…Р В° {_min_txt}; "
           f"Р С—РЎР‚Р С•Р С–Р С•Р Р… {_kinds}; Р С—Р С•Р С”РЎР‚РЎвЂ№РЎвЂљР С‘Р Вµ "
           + (f"{cov:.0f}%" if cov is not None else 'РІР‚вЂќ')
           + ("; Р С—Р С•Р С”РЎР‚РЎвЂ№РЎвЂљР С‘Р Вµ Р С—Р С•Р В»Р Р…Р С•Р Вµ РІР‚вЂќ Р В±РЎРЊР С”РЎвЂљР ВµРЎРѓРЎвЂљ РЎРѓР Р†Р ВµР В¶Р С‘Р в„–" if r.get('score_fresh')
              else "; Р С—Р С•Р С”РЎР‚РЎвЂ№РЎвЂљР С‘Р Вµ < 100% РІР‚вЂќ РЎвЂЎР В°РЎРѓРЎвЂљРЎРЉ Р С”Р С•Р СР В±Р С‘Р Р…Р В°РЎвЂ Р С‘Р в„– Р С‘Р В· Р С”РЎРЊРЎв‚¬Р В°"))
    if _state == 'red':
        tip += ('; НИЖЕ ПОРОГА: бэктест есть, но комбинации отфильтрованы — '
                + (r.get('score_reason') or 'лучший score ниже min_score'))
    return (f"<td class='mono' style='text-align:center;color:{color};' "
            f"title='{tip}'>{sc:.2f}</td>")


def _run_cell(r: dict) -> str:
    """Р С™Р С•Р В»Р С•Р Р…Р С”Р В° Р’В«Р В¤Р С‘Р Р…Р В°Р В»Р С‘Р В·Р С‘РЎР‚Р С•Р Р†Р В°Р Р…Р С•Р’В» РІР‚вЂќ Р В¤Р С’Р С™Р Сћ Р С—Р С•РЎРѓР В»Р ВµР Т‘Р Р…Р ВµР С–Р С• РЎР‚РЎРЊР Р…Р С”Р С‘Р Р…Р С–Р В°, Р В° Р Р…Р Вµ Р Р…Р В°Р СР ВµРЎР‚Р ВµР Р…Р С‘Р Вµ Р С‘Р В· Р С”Р С•Р Т‘Р В°.

    Р вЂ”Р ВµР В»РЎвЂР Р…Р В°РЎРЏ Р С–Р В°Р В»Р С•РЎвЂЎР С”Р В° РІР‚вЂќ Р СР С•Р Т‘РЎС“Р В»РЎРЉ Р ВµРЎРѓРЎвЂљРЎРЉ Р Р† РЎРѓР Р…Р С‘Р СР С”Р Вµ Р С—Р С•РЎРѓР В»Р ВµР Т‘Р Р…Р ВµР С–Р С• Р С—РЎР‚Р С•Р С–Р С•Р Р…Р В° (family_status),
    Р’В«РІР‚вЂќР’В» РІР‚вЂќ Р СР С•Р Т‘РЎС“Р В»РЎРЏ РЎвЂљР В°Р С Р Р…Р ВµРЎвЂљ: Р Р† Р Р…Р С•РЎвЂЎР Р…Р С•Р в„– РЎР‚РЎРЊР Р…Р С”Р С‘Р Р…Р С– Р С•Р Р… Р Р…Р Вµ Р С—Р С•Р С—Р В°Р Т‘Р В°Р В».
    Р СџР С•Р С”РЎР‚РЎвЂ№РЎвЂљР С‘Р Вµ, РЎвЂЎР С‘РЎРѓР В»Р С• РЎРѓР С‘Р СР Р†Р С•Р В»Р С•Р Р† Р С‘ ready_to_trade РІР‚вЂќ Р Р† Р С—Р С•Р Т‘РЎРѓР С”Р В°Р В·Р С”Р Вµ Р С—РЎР‚Р С‘ Р Р…Р В°Р Р†Р ВµР Т‘Р ВµР Р…Р С‘Р С‘.
    """
    if not r['rsym']:
        return f"<td style='text-align:center;color:{COL_MUTED};'>РІР‚вЂќ</td>"
    cov = r['rcov']
    ready = int(r['rready'])
    cov_txt = f"{cov:.0f}%" if cov is not None else 'РІР‚вЂќ'
    _full = (r['rpart'] > 0) and (cov is not None and cov >= 99.5)
    color = COL_GREEN_LT if _full else COL_AMBER
    txt = 'РІСљвЂњ' if _full else '!'
    if ready:  # ready РЎС“РЎвЂ¦Р С•Р Т‘Р С‘РЎвЂљ РЎвЂљР С•Р В»РЎРЉР С”Р С• Р Р† Р С—Р С•Р Т‘РЎРѓР С”Р В°Р В·Р С”РЎС“
        txt = 'РІСљвЂњ' if _full else '!  '
    tip = (f"Р С—Р С•РЎРѓРЎвЂЎР С‘РЎвЂљР В°Р Р…Р С• {r['rcached']} Р С‘Р В· {r['rplanned']} ({cov_txt}); РЎРѓР С‘Р СР Р†Р С•Р В»Р С•Р Р† {r['rsym']}; "
           f"Р Р† РЎР‚РЎРЊР Р…Р С”Р С‘Р Р…Р С–Р Вµ {r['rpart']}; Р С–Р С•РЎвЂљР С•Р Р†РЎвЂ№ РЎвЂљР С•РЎР‚Р С–Р С•Р Р†Р В°РЎвЂљРЎРЉ Р Р…Р В° {ready}")



    return (f"<td class='mono' style='text-align:center;color:{color};' "
            f"title='{tip}'>{txt}</td>")


def _row_html(r: dict) -> str:
    cls = 'inf' if r['infra'] else ''
    if r['infra']:
        tail = ("<td colspan='8' class='left' style='color:#6E7681;'>"
                "Р С‘Р Р…РЎвЂћРЎР‚Р В°РЎРѓРЎвЂљРЎР‚РЎС“Р С”РЎвЂљРЎС“РЎР‚Р В° РІР‚вЂќ Р Р…Р Вµ РЎРѓРЎвЂљРЎР‚Р В°РЎвЂљР ВµР С–Р С‘РЎРЏ</td>")
        return (f"<tr class='{cls}'>"
                f"<td class='mono left'>{r['file']}</td>"
                f"{tail}</tr>")
    cells = [
        f"<td style='text-align:center;color:{COL_GREEN_LT};font-weight:700;'>РІСљвЂњ</td>",
        f"<td class='mono left'>{r['file']}</td>",
        (f"<td class='mono left' style='color:{COL_TEXT};'>{r['calc']}</td>"
         if r['calc'] else f"<td class='mono left' style='color:{COL_MUTED};'>РІР‚вЂќ</td>"),
        _cell(r['entry'] and r['exit']),
        _cell(r['bt']),
        _score_cell(r),
        (f"<td class='mono' style='text-align:center;color:{COL_BLUE};'>{r['key']}</td>"
         if r['reg'] else f"<td style='text-align:center;color:{COL_MUTED};'>РІР‚вЂќ</td>"),
        _cell(r['enabled']),
        _run_cell(r),
        (f"<td class='mono' style='text-align:right;'>{_num(r['combos'])}</td>"
         if r['combos'] else f"<td style='text-align:right;color:{COL_MUTED};'>РІР‚вЂќ</td>"),
        _cell(r['native']),
        (f"<td class='mono' style='text-align:center;color:{COL_AMBER};'>{r['fam']}</td>"
         if r['fam'] else f"<td style='text-align:center;color:{COL_MUTED};'>РІР‚вЂќ</td>"),
        _cell(r['plan'], text='РІСљвЂњ'),
        _cell(r['pos'], text='РІвЂ”РЏ'),
    ]
    # type РІР‚вЂќ Р’В«РЎРѓРЎвЂљРЎР‚Р В°РЎвЂљР ВµР С–Р С‘РЎРЏ Р Р† Р С—Р В»Р В°Р Р…Р ВµР’В»: native-РЎРѓР ВµР СР ВµР в„–РЎРѓРЎвЂљР Р†Р С• Р В»Р С‘Р В±Р С• Р С”Р В»РЎР‹РЎвЂЎ РЎР‚Р ВµР ВµРЎРѓРЎвЂљРЎР‚Р В°.
    # type-РЎРЏРЎвЂЎР ВµР в„–Р С”Р В° Р Р…РЎС“Р В¶Р Р…Р В° Р Р…Р С‘Р В¶Р Вµ: РЎРѓР С”Р В»Р ВµР С‘Р Р†Р В°Р ВµР С Р Р†Р С‘Р Т‘Р С‘Р СРЎвЂ№Р в„– Р С—Р С•РЎР‚РЎРЏР Т‘Р С•Р С” Р С”Р С•Р В»Р С•Р Р…Р С•Р С” Р С—Р С•РЎРѓР В»Р Вµ Р ВµРЎвЂ РЎРѓР В±Р С•РЎР‚Р С”Р С‘.

    _type = (f"<td class='mono' style='text-align:center;color:{COL_AMBER};'>"
             f"{r['fam']}<span style='color:{COL_MUTED};font-size:0.72rem;'> native</span></td>"
             if r['native'] else
             f"<td class='mono' style='text-align:center;color:{COL_BLUE};'>"
             f"{r['key']}<span style='color:{COL_MUTED};font-size:0.72rem;'> РЎР‚Р ВµР ВµРЎРѓРЎвЂљРЎР‚</span></td>"
             if r['reg'] else
             f"<td style='text-align:center;color:{COL_MUTED};'>РІР‚вЂќ</td>")
    # Р вЂ™Р С‘Р Т‘Р С‘Р СРЎвЂ№Р Вµ Р С”Р С•Р В»Р С•Р Р…Р С”Р С‘: Р СљР С•Р Т‘РЎС“Р В»РЎРЉ Р’В· Р В Р В°РЎРѓРЎвЂЎРЎвЂРЎвЂљ РЎРѓР С‘Р С–Р Р…Р В°Р В»Р В° Р’В· type Р’В· score Р’В· Standalone Р’В·
    # backtest Р’В· score Р’В· Р В¤Р С‘Р Р…Р В°Р В»Р С‘Р В·Р С‘РЎР‚Р С•Р Р†Р В°Р Р…Р С• Р’В· Р вЂ™ Р С—Р В»Р В°Р Р…Р Вµ. Р С›РЎРѓРЎвЂљР В°Р В»РЎРЉР Р…РЎвЂ№Р Вµ РЎРЏРЎвЂЎР ВµР в„–Р С”Р С‘ (Р С”Р В»РЎР‹РЎвЂЎ РЎР‚Р ВµР ВµРЎРѓРЎвЂљРЎР‚Р В°,
    # Р В±Р В°РЎвЂљРЎвЂЎ, Р С”Р С•Р СР В±Р С‘Р Р…Р В°РЎвЂ Р С‘Р С‘, native, РЎРѓР ВµР СР ВµР в„–РЎРѓРЎвЂљР Р†Р С•, Р С—Р С•Р В·Р С‘РЎвЂ Р С‘РЎРЏ) РЎРѓРЎвЂЎР С‘РЎвЂљР В°РЎР‹РЎвЂљРЎРѓРЎРЏ, Р Р…Р С• Р Р…Р Вµ РЎР‚Р С‘РЎРѓРЎС“РЎР‹РЎвЂљРЎРѓРЎРЏ.
    _cells = [cells[1], cells[2], _type, cells[5], cells[0], cells[3], cells[4],
              cells[8], cells[12]]
    return f"<tr class='{cls}'>{''.join(_cells)}</tr>"


def render_roadmap_tab() -> None:
    st.markdown(_CSS, unsafe_allow_html=True)

    rows, stat = _scan()
    if not rows:
        st.warning(f"Р СџР В°Р С—Р С”Р В° strategies/ Р Р…Р ВµР Т‘Р С•РЎРѓРЎвЂљРЎС“Р С—Р Р…Р В° Р С‘Р В»Р С‘ Р С—РЎС“РЎРѓРЎвЂљР В°: `{STRAT_DIR}`")
        return  # Р Р…Р Вµ st.stop(): Roadmap РЎР‚Р ВµР Р…Р Т‘Р ВµРЎР‚Р С‘РЎвЂљРЎРѓРЎРЏ РЎР‚Р В°Р Р…РЎРЉРЎв‚¬Р Вµ Backtest РІР‚вЂќ stop РЎС“Р В±Р С‘Р В» Р В±РЎвЂ№ Р С‘ Р ВµР С–Р С•

    st.markdown(_stats_html(stat), unsafe_allow_html=True)

    # РІвЂќР‚РІвЂќР‚ Р В¤Р С‘Р В»РЎРЉРЎвЂљРЎР‚РЎвЂ№ РІвЂќР‚РІвЂќР‚
    f1, f2, f3 = st.columns([2, 2, 2])
    with f1:
        query = st.text_input("Р СџР С•Р С‘РЎРѓР С” Р С—Р С• Р С‘Р СР ВµР Р…Р С‘ РЎвЂћР В°Р в„–Р В»Р В° / Р С”Р В»РЎР‹РЎвЂЎРЎС“", '', key='rdm_q')
    with f2:
        view = st.selectbox(
            "Р СџР С•Р С”Р В°Р В·Р В°РЎвЂљРЎРЉ",
            ("Р вЂ™РЎРѓР Вµ", "Р СћР С•Р В»РЎРЉР С”Р С• Р С—РЎР‚Р С•Р В±Р ВµР В»РЎвЂ№ (Р Р…Р ВµРЎвЂљ Р Р…Р С‘ Р Р† РЎР‚Р ВµР ВµРЎРѓРЎвЂљРЎР‚Р Вµ, Р Р…Р С‘ Р Р† native)",
             "Р СћР С•Р В»РЎРЉР С”Р С• РЎР‚Р ВµР ВµРЎРѓРЎвЂљРЎР‚", "Р СћР С•Р В»РЎРЉР С”Р С• Р В±Р В°РЎвЂљРЎвЂЎ", "Р СћР С•Р В»РЎРЉР С”Р С• native", "Р СћР С•Р В»РЎРЉР С”Р С• Р Р† Р С—Р В»Р В°Р Р…Р Вµ",
             "Р СћР С•Р В»РЎРЉР С”Р С• Р С–Р С•РЎвЂљР С•Р Р†РЎвЂ№Р Вµ Р С” РЎвЂљР С•РЎР‚Р С–Р С•Р Р†Р В»Р Вµ", "Р СћР С•Р В»РЎРЉР С”Р С• Р Р…Р Вµ РЎвЂћР С‘Р Р…Р В°Р В»Р С‘Р В·Р С‘РЎР‚Р С•Р Р†Р В°Р Р…Р Р…РЎвЂ№Р Вµ"),
            key='rdm_view',
        )
    with f3:
        hide_infra = st.checkbox("Р РЋР С”РЎР‚РЎвЂ№РЎвЂљРЎРЉ Р С‘Р Р…РЎвЂћРЎР‚Р В°РЎРѓРЎвЂљРЎР‚РЎС“Р С”РЎвЂљРЎС“РЎР‚РЎС“", value=True, key='rdm_hide_infra')
        only_below = st.checkbox("Только ниже порога (score < min_score)",
                                value=False, key='rdm_below')

    q = (query or '').strip().lower()
    shown = []
    for r in rows:
        if hide_infra and r['infra']:
            continue
        if q and q not in r['module'].lower() and q not in r['key'].lower():
            continue
        if view == 'Р СћР С•Р В»РЎРЉР С”Р С• Р С—РЎР‚Р С•Р В±Р ВµР В»РЎвЂ№ (Р Р…Р ВµРЎвЂљ Р Р…Р С‘ Р Р† РЎР‚Р ВµР ВµРЎРѓРЎвЂљРЎР‚Р Вµ, Р Р…Р С‘ Р Р† native)' and (r['reg'] or r['native']):
            continue
        if view == 'Р СћР С•Р В»РЎРЉР С”Р С• РЎР‚Р ВµР ВµРЎРѓРЎвЂљРЎР‚' and not r['reg']:
            continue
        if view == 'Р СћР С•Р В»РЎРЉР С”Р С• Р В±Р В°РЎвЂљРЎвЂЎ' and not r['enabled']:
            continue
        if view == 'Р СћР С•Р В»РЎРЉР С”Р С• native' and not r['native']:
            continue
        if view == 'Р СћР С•Р В»РЎРЉР С”Р С• Р Р† Р С—Р В»Р В°Р Р…Р Вµ' and not r['plan']:
            continue
        if view == 'Р СћР С•Р В»РЎРЉР С”Р С• Р С–Р С•РЎвЂљР С•Р Р†РЎвЂ№Р Вµ Р С” РЎвЂљР С•РЎР‚Р С–Р С•Р Р†Р В»Р Вµ' and not r['rready']:
            continue
        if view == 'Р СћР С•Р В»РЎРЉР С”Р С• Р Р…Р Вµ РЎвЂћР С‘Р Р…Р В°Р В»Р С‘Р В·Р С‘РЎР‚Р С•Р Р†Р В°Р Р…Р Р…РЎвЂ№Р Вµ' and r['rsym']:
            continue
            # Р Т‘РЎС“Р В±Р В»РЎРЉ continue РЎС“Р В±РЎР‚Р В°Р Р… (РЎвЂћР С‘Р В»РЎРЉРЎвЂљРЎР‚ Р Р†РЎвЂ№РЎв‚¬Р Вµ)
        if only_below and r.get('score_state') != 'red':
            continue   # «ниже порога»: посчитано, но комбинации отфильтрованы
        shown.append(r)

    if not shown:
        st.info("Р СџР С•Р Т‘ РЎвЂћР С‘Р В»РЎРЉРЎвЂљРЎР‚ Р Р…Р С‘РЎвЂЎР ВµР С–Р С• Р Р…Р Вµ Р С—Р С•Р Т‘Р С•РЎв‚¬Р В»Р С•.")
        return

    head = (
        "<table class='rdm'><thead><tr>"
        # Module Р’В· Signal calc Р’В· type Р’В· Standalone Р’В· entry+exit Р’В· backtest Р’В· Finalized Р’В· In plan
        "<th class='left'>Module</th>"
        "<th class='left' title='Signal calc: def calc_... inside the module'>Signal calc</th>"
        "<th title='Strategy Tree type: registry key or native family'>type</th>"
        "<th title='Module file exists in strategies/'>Standalone</th>"
        "<th>entry+exit</th>"
        "<th>backtest</th>"
        # type Р С—Р ВµРЎР‚Р ВµР ВµРЎвЂ¦Р В°Р В» РЎРѓРЎР‚Р В°Р В·РЎС“ Р С—Р С•РЎРѓР В»Р Вµ Signal calc
        # (РЎС“Р В±РЎР‚Р В°Р Р…Р С•: Р’В«Р вЂР В°РЎвЂљРЎвЂЎР’В» РІР‚вЂќ Р С”Р В»РЎР‹РЎвЂЎ ENABLED_BATCH Р Р†Р С‘Р Т‘Р ВµР Р… Р Р† Р С—Р С•Р Т‘РЎРѓР С”Р В°Р В·Р С”Р Вµ Р С”Р С•Р В»Р С•Р Р…Р С”Р С‘ type)
        "<th title='Score РЎРѓР ВµР СР ВµР в„–РЎРѓРЎвЂљР Р†Р В° Р Р…Р В° Р С—Р С•РЎРѓР В»Р ВµР Т‘Р Р…Р ВµР С РЎР‚РЎРЊР Р…Р С”Р С‘Р Р…Р С–Р Вµ: РЎРѓРЎР‚Р ВµР Т‘Р Р…Р ВµР Вµ best_score Р С—Р С• "
        "РЎРѓР С‘Р СР Р†Р С•Р В»Р В°Р С. Р вЂ”Р ВµР В»РЎвЂР Р…РЎвЂ№Р в„– РІР‚вЂќ Р С”Р С•Р СР В±Р С‘Р Р…Р В°РЎвЂ Р С‘Р С‘ Р С—Р С•РЎРѓРЎвЂЎР С‘РЎвЂљР В°Р Р…РЎвЂ№ Р С—Р С•Р В»Р Р…Р С•РЎРѓРЎвЂљРЎРЉРЎР‹, "
        "Р В¶РЎвЂР В»РЎвЂљРЎвЂ№Р в„– РІР‚вЂќ РЎвЂЎР В°РЎРѓРЎвЂљРЎРЉ Р С‘Р В· Р С”РЎРЊРЎв‚¬Р В° (score РЎРѓРЎвЂљР В°РЎР‚РЎв‚¬Р Вµ Р В±РЎРЊР С”РЎвЂљР ВµРЎРѓРЎвЂљР В°)'>score</th>"
        "<th>Finalized</th>"
        # (РЎС“Р В±РЎР‚Р В°Р Р…Р С•: Р’В«Р С™Р С•Р СР В±./РЎРѓР С‘Р СР Р†.Р’В» РІР‚вЂќ Р Р…Р ВµР С‘Р Р…РЎвЂћР С•РЎР‚Р СР В°РЎвЂљР С‘Р Р†Р Р…Р С•)
        # (РЎС“Р В±РЎР‚Р В°Р Р…Р С•: native-РЎРѓР В»Р С•Р в„– Р С—Р С•Р С”Р В°Р В·Р В°Р Р… Р С—РЎР‚РЎРЏР СР С• Р Р† Р С”Р С•Р В»Р С•Р Р…Р С”Р Вµ type)
        # (РЎС“Р В±РЎР‚Р В°Р Р…Р С•: Р С‘Р СРЎРЏ РЎРѓР ВµР СР ВµР в„–РЎРѓРЎвЂљР Р†Р В° Р С—Р С•Р С”Р В°Р В·Р В°Р Р…Р С• Р Р† Р С”Р С•Р В»Р С•Р Р…Р С”Р Вµ type)
        "<th>In plan</th>"
        # (РЎС“Р В±РЎР‚Р В°Р Р…Р С•: Р С”Р С•Р В»Р С•Р Р…Р С”Р В° Р’В«Р СџР С•Р В·Р С‘РЎвЂ Р С‘РЎРЏР’В»)
        "</tr></thead><tbody>"
    )
    body = ''.join(_row_html(r) for r in shown)
    st.markdown(f"<div class='rdm-wrap'>{head}{body}</tbody></table></div>",
                unsafe_allow_html=True)
    _snap = stat.get('run_snap') or ''
    _n_score = sum(1 for r in shown if r.get('score') is not None)
    _n_red = sum(1 for r in shown if r.get('score_state') == 'red')
    st.caption(f"score: красным — {_n_red} строк ниже порога min_score (бэктест есть, "
               f"но комбинации отфильтрованы; показана реальная оценка, а не прочерк). "
               f"Зелёный — выше порога и покрытие полное, жёлтый — выше порога, "
               f"но часть комбинаций из кэша.")
    _snap_txt = f" Р С•РЎвЂљ {_snap}" if _snap else " РІР‚вЂќ Р вЂР вЂќ Р В¶РЎС“РЎР‚Р Р…Р В°Р В»Р С•Р Р† Р Р…Р ВµР Т‘Р С•РЎРѓРЎвЂљРЎС“Р С—Р Р…Р В°"
    st.caption(f"Р СџР С•Р С”Р В°Р В·Р В°Р Р…Р С• {len(shown)} Р С‘Р В· {stat['files']} РЎвЂћР В°Р в„–Р В»Р С•Р Р†. "
               f"Р В¤Р С‘Р Р…Р В°Р В»Р С‘Р В·Р С‘РЎР‚Р С•Р Р†Р В°Р Р…Р С•: family_status{_snap_txt}. "
               f"score: Р В·Р ВµР В»РЎвЂР Р…РЎвЂ№Р в„– РІР‚вЂќ Р С”Р С•Р СР В±Р С‘Р Р…Р В°РЎвЂ Р С‘Р С‘ Р С—Р С•РЎРѓРЎвЂЎР С‘РЎвЂљР В°Р Р…РЎвЂ№ Р С—Р С•Р В»Р Р…Р С•РЎРѓРЎвЂљРЎРЉРЎР‹; Р В¶РЎвЂР В»РЎвЂљРЎвЂ№Р в„– РІР‚вЂќ РЎвЂЎР В°РЎРѓРЎвЂљРЎРЉ Р С‘Р В· "
               f"Р С”РЎРЊРЎв‚¬Р В°. Р вЂўРЎРѓРЎвЂљРЎРЉ РЎС“ {_n_score} Р С‘Р В· {len(shown)} РЎРѓРЎвЂљРЎР‚Р С•Р С” (Р С—РЎР‚Р С‘РЎвЂЎР С‘Р Р…Р В° Р’В«РІР‚вЂќР’В» РІР‚вЂќ Р Р† "
               f"Р С—Р С•Р Т‘РЎРѓР С”Р В°Р В·Р С”Р Вµ Р С”РЎС“РЎР‚РЎРѓР С•РЎР‚Р С•Р С). "
               f"Р вЂ™Р С‘Р Т‘ Р С—Р С•РЎРѓР В»Р ВµР Т‘Р Р…Р ВµР С–Р С• Р С—РЎР‚Р С•Р С–Р С•Р Р…Р В°: "
               f"{', '.join(stat.get('run_kinds') or []) or 'РІР‚вЂќ'}. "

               f"Р С™РЎРЊРЎв‚¬ Р С‘Р Р…Р Р†Р ВµР Р…РЎвЂљР В°РЎР‚Р С‘Р В·Р В°РЎвЂ Р С‘Р С‘ РІР‚вЂќ 2 Р СР С‘Р Р… (Р С•Р В±Р Р…Р С•Р Р†Р С‘РЎвЂљРЎРѓРЎРЏ РЎРѓР В°Р СР С• Р С—Р С•РЎРѓР В»Р Вµ Р Т‘Р ВµР С—Р В»Р С•РЎРЏ)."
               )

    with st.expander("Р В§РЎвЂљР С• Р С•Р В·Р Р…Р В°РЎвЂЎР В°Р ВµРЎвЂљ Р С”Р В°Р В¶Р Т‘Р В°РЎРЏ Р С”Р С•Р В»Р С•Р Р…Р С”Р В°", expanded=False):
        st.markdown(
            """
| Р С™Р С•Р В»Р С•Р Р…Р С”Р В° | Р С›РЎвЂљР С”РЎС“Р Т‘Р В° Р В±Р ВµРЎР‚РЎвЂРЎвЂљРЎРѓРЎРЏ | Р В§РЎвЂљР С• Р В·Р Р…Р В°РЎвЂЎР С‘РЎвЂљ |
|---|---|---|
| **Standalone** | `os.listdir('strategies')` | Р В¤Р В°Р в„–Р В» Р СР С•Р Т‘РЎС“Р В»РЎРЏ РЎРѓРЎС“РЎвЂ°Р ВµРЎРѓРЎвЂљР Р†РЎС“Р ВµРЎвЂљ. Р вЂ”Р ВµР В»РЎвЂР Р…Р В°РЎРЏ Р С–Р В°Р В»Р С•РЎвЂЎР С”Р В° РЎС“ Р Р†РЎРѓР ВµРЎвЂ¦ РІР‚вЂќ РЎРЊРЎвЂљР С• Р С•РЎвЂљР С—РЎР‚Р В°Р Р†Р Р…Р В°РЎРЏ РЎвЂљР С•РЎвЂЎР С”Р В°, Р В° Р Р…Р Вµ Р’В«Р С—Р С•Р Т‘Р С”Р В»РЎР‹РЎвЂЎР ВµР Р…Р С•Р’В». |
| **Р СљР С•Р Т‘РЎС“Р В»РЎРЉ** | Р С‘Р СРЎРЏ РЎвЂћР В°Р в„–Р В»Р В° | `xxx.py` РІвЂ вЂ™ Р СР С•Р Т‘РЎС“Р В»РЎРЉ `strategies.xxx`. |
| **Р В Р В°РЎРѓРЎвЂЎРЎвЂРЎвЂљ РЎРѓР С‘Р С–Р Р…Р В°Р В»Р В°** | РЎР‚Р ВµР С–Р ВµР С”РЎРѓР С— `^def calc_\\w+` Р Р† РЎвЂћР В°Р в„–Р В»Р Вµ | Р В¤РЎС“Р Р…Р С”РЎвЂ Р С‘РЎРЏ РЎР‚Р В°РЎРѓРЎвЂЎРЎвЂРЎвЂљР В° РЎРѓР С‘Р С–Р Р…Р В°Р В»РЎРЉР Р…Р С•Р в„– Р С”Р С•Р В»Р С•Р Р…Р С”Р С‘ `k`. Р вЂўРЎРѓРЎвЂљРЎРЉ РІР‚вЂќ Р СР С•Р Т‘РЎС“Р В»РЎРЉ Р В¶Р С‘Р Р†Р С•Р в„–, Р Р…Р ВµРЎвЂљ РІР‚вЂќ Р В·Р В°Р С–Р С•РЎвЂљР С•Р Р†Р С”Р В°. |
| **entry+exit** | `def check_entry` / `def check_exit` | Live-Р С”Р С•Р Р…РЎвЂљРЎР‚Р В°Р С”РЎвЂљ РЎР‚Р ВµР ВµРЎРѓРЎвЂљРЎР‚Р В°: Р В±Р ВµР В· Р Р…Р С‘РЎвЂ¦ РЎР‚Р ВµР ВµРЎРѓРЎвЂљРЎР‚ Р Р…Р Вµ Р СР С•Р В¶Р ВµРЎвЂљ РЎвЂљР С•РЎР‚Р С–Р С•Р Р†Р В°РЎвЂљРЎРЉ Р СР С•Р Т‘РЎС“Р В»РЎРЉ. |
| **backtest** | `def backtest` | Р В¤РЎС“Р Р…Р С”РЎвЂ Р С‘РЎРЏ Р С—РЎР‚Р С•Р С–Р С•Р Р…Р В° Р Т‘Р В»РЎРЏ Р Р…Р С•РЎвЂЎР Р…Р С•Р в„– РЎРѓР ВµРЎвЂљР С”Р С‘. |
